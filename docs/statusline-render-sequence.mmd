%% Status Line Render Flow: How the widget gets data and displays
%% Render: cat statusline-render-sequence.mmd | mermaid-ascii -f -
%% Focus: Cached-state read path - no git diff work per refresh

sequenceDiagram
    participant CC as Claude Code
    participant Script as Status Script
    participant BL as bumper-lanes
    participant Sess as Session
    participant Git

    %% Claude Code triggers status line refresh
    CC->>Script: invoke with JSON stdin
    Script->>Script: input=$(cat)

    %% Script calls bumper-lanes status
    Script->>BL: echo $input | bumper-lanes status

    %% bumper-lanes parses input
    BL->>BL: parse JSON (session_id, model, cost)

    %% Cheap git reads for branch display only
    BL->>Git: git branch --show-current / git diff --quiet
    Git-->>BL: branch name, dirty flag

    %% Load cached session state (score computed at hook time)
    BL->>Sess: load(session_id)
    Sess-->>BL: score, threshold, paused, stop_triggered, tripwires, net_lines

    %% Format the one-line indicator
    BL->>BL: gauge = traffic-light bar + pct (+ red warning glyph, + green net lines)
    BL-->>Script: model | dir | branch | cost | gauge

    %% Script outputs to Claude Code
    Script-->>CC: single-line status output

%% ============================================================
%% VALIDATION REFERENCES
%% ============================================================
%% - Status input parsing: internal/statusline/statusline.go (ParseInput)
%% - Session load: internal/statusline/statusline.go (Render)
%% - Indicator formatting: internal/statusline/statusline.go (formatBumperStatus)
%%
%% WIDGET MODES (--widget flag)
%% - all: full status line (default)
%% - indicator: just the gauge, e.g. "▂ 31%"
%% - diff-tree: accepted from pre-v4 wrappers, outputs nothing
%%
%% NOTES
%% 1. No baseline diff per refresh: score and net_lines are cached in
%%    session state by the Write/Edit and Stop hooks (a working-tree
%%    capture costs ~60-110ms and is too slow for the statusline path)
%% 2. Rich diff visualization is on-demand via /bumper-diff
