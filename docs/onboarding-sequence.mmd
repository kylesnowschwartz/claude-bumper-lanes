%% Onboarding Flow: Plugin install → working status line
%% Render: cat onboarding-sequence.mmd | mermaid-ascii -f -
%% Focus: User-facing steps only (internal details omitted)

sequenceDiagram
    participant User
    participant CLI as Claude CLI
    participant CC as Claude Code
    participant FS as ~/.claude/

    %% Phase 1: Plugin Installation (two commands)
    User->>CLI: marketplace add kylesnowschwartz/claude-bumper-lanes
    CLI-->>User: plugin added

    User->>CLI: plugin install claude-bumper-lanes
    CLI-->>User: plugin installed

    %% Phase 2: First Session (auto-setup)
    User->>CC: start session in git repo
    CC->>CC: version check (plugin.json vs .build-version)
    CC->>CC: (builds Go binaries ~15s if new/updated)

    %% Status line setup: binary-path repair always runs; fresh install is opt-in
    alt Status line already points at bumper-lanes binary (repair - always runs)
        CC->>FS: compare settings path vs current binary path
        CC->>FS: update statusLine.command if stale (via jq)
        CC-->>User: stderr: Updated status line for new version. Restart session.
    else Existing foreign status line command
        Note over CC: User's own status line - never touched
        CC-->>CC: (silent; compose the gauge via `bumper-lanes status --widget=indicator`)
    else statusline_auto_setup not set (default)
        Note over CC: Fresh install requires opt-in - nothing happens
        CC-->>CC: (silent; set statusline_auto_setup: true in .bumper-lanes.json to enable)
    else Opt-in + no existing status line
        CC->>FS: set statusLine.command to binary path (via jq)
        CC-->>User: stderr: Status line configured! Restart session.
    end

    %% Phase 3: Working
    User->>CC: restart session
    CC-->>User: diff tree visible in status line

%% ============================================================
%% VALIDATION REFERENCES
%% ============================================================
%% - Plugin install: README.md:24-27
%% - Version sentinel: scripts/ensure-binaries.sh
%% - Auto-setup entry point (cross-package call from SessionStart): internal/statusline/installer.go:EnsureInstalled()
%% - Staleness check: internal/statusline/installer.go:isBinaryStale()
%% - Settings update: internal/statusline/installer.go:updateSettingsWithJq()
%%
%% SETUP MODEL
%% 1. Fresh installation rewrites ~/.claude/settings.json (user-global), so it
%%    requires statusline_auto_setup: true in config - opt-in, default off - and
%%    only applies when no status line is configured.
%% 2. Repair of an already-installed binary path always runs: the user opted in
%%    by installing, and plugin updates move the binary path.
%% 3. A foreign statusLine.command is never modified; custom status lines
%%    compose the gauge with `bumper-lanes status --widget=indicator`.
%% 4. Setup is idempotent (checks actual state each session).
%% 5. Two CLI commands + session restart + 10-15s first build - Claude Code limitations.
